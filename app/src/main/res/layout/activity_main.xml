<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Lumi + sky, full bleed behind everything -->
    <com.lou.lumi.ui.PetView
        android:id="@+id/pet"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- top: name, age, brain status, menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="Lumi"
                    android:textColor="@color/fg"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="noch im Ei"
                    android:textColor="@color/fg_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMenu"
                style="@style/Lumi.RoundButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="Menü"
                android:padding="12dp"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <TextView
            android:id="@+id/brainStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="Gehirn schläft noch"
            android:textColor="@color/fg_dim"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:textColor="@color/fg_dim"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingMultiplier="1.12"
            android:maxLines="4"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:shadowColor="#AA000000"
            android:shadowRadius="12"
            android:textColor="@color/fg"
            android:textSize="19sp" />

        <!-- Play policy on AI content: report an answer without leaving the app -->
        <TextView
            android:id="@+id/reportChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="Diese Antwort melden"
            android:gravity="center"
            android:minHeight="32dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="⚑  Antwort melden"
            android:textColor="@color/fg_dim"
            android:textSize="12sp"
            android:visibility="invisible" />

        <!-- typing instead of talking -->
        <LinearLayout
            android:id="@+id/inputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Schreib Lumi etwas …"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/fg"
                android:textColorHint="@color/fg_dim"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnSend"
                style="@style/Lumi.RoundButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Senden"
                android:padding="13dp"
                android:src="@drawable/ic_send" />
        </LinearLayout>

        <com.lou.lumi.ui.NeedsView
            android:id="@+id/needs"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp" />

        <!-- care actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="14dp">

            <LinearLayout style="@style/Lumi.Cell">

                <ImageButton
                    android:id="@+id/btnFeed"
                    style="@style/Lumi.RoundButton"
                    android:contentDescription="Füttern"
                    android:src="@drawable/ic_feed" />

                <TextView
                    style="@style/Lumi.Label"
                    android:text="Füttern" />
            </LinearLayout>

            <LinearLayout style="@style/Lumi.Cell">

                <ImageButton
                    android:id="@+id/btnPlay"
                    style="@style/Lumi.RoundButton"
                    android:contentDescription="Spielen"
                    android:src="@drawable/ic_play" />

                <TextView
                    style="@style/Lumi.Label"
                    android:text="Spielen" />
            </LinearLayout>

            <LinearLayout
                style="@style/Lumi.Cell"
                android:layout_weight="1.3">

                <ImageButton
                    android:id="@+id/btnTalk"
                    style="@style/Lumi.RoundButton"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_talk"
                    android:contentDescription="Reden"
                    android:elevation="6dp"
                    android:padding="20dp"
                    android:src="@drawable/ic_mic" />

                <TextView
                    android:id="@+id/talkLabel"
                    style="@style/Lumi.Label"
                    android:text="Reden" />
            </LinearLayout>

            <LinearLayout style="@style/Lumi.Cell">

                <ImageButton
                    android:id="@+id/btnSleep"
                    style="@style/Lumi.RoundButton"
                    android:contentDescription="Schlafen"
                    android:src="@drawable/ic_sleep" />

                <TextView
                    android:id="@+id/sleepLabel"
                    style="@style/Lumi.Label"
                    android:text="Licht aus" />
            </LinearLayout>

            <LinearLayout style="@style/Lumi.Cell">

                <ImageButton
                    android:id="@+id/btnChat"
                    style="@style/Lumi.RoundButton"
                    android:contentDescription="Schreiben"
                    android:src="@drawable/ic_chat" />

                <TextView
                    style="@style/Lumi.Label"
                    android:text="Schreiben" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
