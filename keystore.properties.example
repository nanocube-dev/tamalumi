# Vorlage. Kopieren nach keystore.properties (wird NICHT eingecheckt) und anpassen.
# Der Keystore liegt AUSSERHALB des Projekts. Passwörter stehen hier nicht drin:
# .\tools\build-release.ps1 fragt sie beim Bauen ab.
storeFile=C:/Users/<dein Name>/Schluessel/Lumi/lumi-upload.jks
keyAlias=lumi-upload
